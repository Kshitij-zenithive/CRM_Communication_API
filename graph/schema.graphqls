# graph/schema.graphqls

# --- Custom Scalars ---
scalar Time   # Represents a time value, likely RFC3339 format
scalar JSON   # Represents a JSON object/value

# --- Enums ---
enum ConversationType {
  DIRECT  # DM between internal users
  GROUP   # Group chat between internal users
  CLIENT  # Chat involving a client
}

enum MessageType {
  TEXT
  SYSTEM
  COMMAND_OUTPUT
  EMAIL_IN_THREAD
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

# --- Core Object Types ---

type User {
  id: ID!
  name: String!
  email: String!
  avatar: String
  role: String!
  createdAt: Time!
  updatedAt: Time!
}

type Client {
  id: ID!
  name: String!
  email: String!
  company: String
  createdAt: Time!
  updatedAt: Time!
}

type Conversation {
  id: ID!
  type: ConversationType!
  name: String
  clientId: ID # Link to Client ID
  createdAt: Time!
  updatedAt: Time!

  # Relations
  participants: [ConversationParticipant!]!
  messages(pagination: PaginationInput): MessageConnection # Paginated messages
  client: Client # Populated if clientId is not null
}

type ConversationParticipant {
  user: User!
  joinedAt: Time!
}

type Message {
  id: ID!
  conversationId: ID! # ID of the conversation it belongs to
  sender: User!
  content: String!
  type: MessageType!
  metadata: JSON # Flexible field for command output, email links etc.
  createdAt: Time!
  updatedAt: Time!
  # readBy: [User!] # Add back if/when read receipts are fully implemented
}

type Email {
  id: ID!
  clientId: ID # Nullable client link
  userId: ID! # Internal user associated
  provider: String # e.g., "gmail", "manual"
  providerId: String # ID from the source system
  threadId: String
  subject: String
  from: String!
  to: [String!]!
  cc: [String!]
  bcc: [String!]
  bodyHtml: String
  bodyText: String
  snippet: String
  sentAt: Time
  receivedAt: Time
  isRead: Boolean!
  direction: EmailDirection!
  createdAt: Time!
  updatedAt: Time!

  # Relations
  attachments: [EmailAttachment!]
  client: Client # Populated if clientId is not null
  user: User! # The internal user this email is associated with
}

type EmailAttachment {
  id: ID!
  filename: String!
  mimeType: String
  size: Int! # Assuming size fits in 32-bit Int
  downloadUrl: String # Optional presigned URL
  createdAt: Time!
}

type EmailTemplate {
  id: ID!
  name: String!
  subject: String!
  body: String!
  createdAt: Time!
  updatedAt: Time!
}
type AuthPayload {
  accessToken: String!
  refreshToken: String! # Client receives this but typically stores it securely (e.g., httpOnly cookie)
  user: User!
}


# --- Input Types ---

input ClientFilterInput {
  nameContains: String
  email: String
}

input ConversationFilterInput {
  userId: ID
  clientId: ID
  type: ConversationType
}

input EmailFilterInput {
  clientId: ID
  userId: ID
  subjectContains: String
  from: String
  toContains: String
  direction: EmailDirection
  isRead: Boolean
  after: Time
  before: Time
}

input PaginationInput {
  first: Int
  after: String
  last: Int
  before: String
}

# Refined SendEmailInput
input SendEmailInput {
  clientId: ID         # Optional client association ID
  to: [String!]!
  cc: [String!]
  bcc: [String!]
  subject: String        # Optional if templateId is provided
  bodyHtml: String       # Optional if templateId is provided
  bodyText: String       # Optional if templateId is provided
  templateId: ID         # Optional template to use
  templateData: JSON     # Optional JSON object for template variables
}

input CreateClientInput {
    name: String!
    email: String!
    company: String
}

input UpdateClientInput {
    id: ID!
    name: String
    email: String
    company: String
}

input CreateConversationInput {
    type: ConversationType!
    name: String       # Required for GROUP type
    clientId: ID       # Optional for CLIENT type (can be linked later?) - Make required for CLIENT type? Let's keep optional for now.
    participantUserIds: [ID!]! # List of user IDs (must include self?)
}

input CreateEmailTemplateInput {
    name: String!
    subject: String!
    body: String!
}

input UpdateEmailTemplateInput {
    id: ID!
    name: String
    subject: String
    body: String
}

# Added for Auth
input NewUserInput {
  name: String!
  email: String!
  password: String!
  avatar: String
  role: String # Optional: Default to 'user'
}

# --- Connection Types ---

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type MessageEdge {
  cursor: String!
  node: Message!
}

type MessageConnection {
  edges: [MessageEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type EmailEdge {
    cursor: String!
    node: Email!
}

type EmailConnection {
    edges: [EmailEdge!]!
    pageInfo: PageInfo!
    totalCount: Int
}

# --- Root Operations ---

type Query {
  # Auth Query
  me: User! # Get current authenticated user

  # User Queries
  user(id: ID!): User
  users(filter: ClientFilterInput, pagination: PaginationInput): [User!]! # Simple list

  # Client Queries
  client(id: ID!): Client
  clients(filter: ClientFilterInput, pagination: PaginationInput): [Client!]! # Simple list

  # Conversation Queries
  conversation(id: ID!): Conversation
  conversations(filter: ConversationFilterInput, pagination: PaginationInput): [Conversation!]! # Simple list

  # Message Queries -> Field on Conversation type

  # Email Queries
  email(id: ID!): Email
  emails(filter: EmailFilterInput, pagination: PaginationInput): EmailConnection!

  # Email Template Queries
  emailTemplate(id: ID!): EmailTemplate
  emailTemplates: [EmailTemplate!]!
}

type Mutation {
  # Auth Mutations
  login(email: String!, password: String!): AuthPayload!
  googleLogin(code: String!): AuthPayload!
  refreshToken(refreshToken: String!): AuthPayload!
  createUser(input: NewUserInput!): User! # Added back

  # Client Mutations
  createClient(input: CreateClientInput!): Client!
  updateClient(input: UpdateClientInput!): Client!

  # Conversation Mutations
  createConversation(input: CreateConversationInput!): Conversation!
  addParticipant(conversationId: ID!, userId: ID!): ConversationParticipant!
  removeParticipant(conversationId: ID!, userId: ID!): Boolean!

  # Message Mutations
  sendMessage(conversationId: ID!, content: String!): Message!
  markMessageAsRead(messageId: ID!): Boolean! # Added back

  # Email Mutations
  sendEmail(input: SendEmailInput!): Email!
  syncGmail: Boolean! # Added back

  # Email Template Mutations
  createEmailTemplate(input: CreateEmailTemplateInput!): EmailTemplate!
  updateEmailTemplate(input: UpdateEmailTemplateInput!): EmailTemplate!
  deleteEmailTemplate(id: ID!): Boolean!
}

type Subscription {
  newMessage(conversationId: ID!): Message!
  conversationUpdated(conversationId: ID!): Conversation!
}