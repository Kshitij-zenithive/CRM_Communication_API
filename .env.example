# ===== DATABASE CONFIGURATION =====
# PostgreSQL database connection string
DATABASE_URL=" Insert here" 
# ===== API CONFIGURATION =====
# API server port
API_PORT=5000
# Hostname and protocol for public-facing URLs
API_HOST=http://localhost
# Full base URL (derived from host and port)
API_BASE_URL=http://localhost:5000

# ===== AUTHENTICATION =====
# Secret for signing JWT tokens
JWT_SECRET=your_jwt_secret_here
# JWT expiration time in hours
JWT_EXPIRY_HOURS=24

# ===== GMAIL INTEGRATION =====
# Google OAuth credentials for Gmail API
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# OAuth callback URL
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ===== TWILIO INTEGRATION =====
# Twilio credentials for SMS functionality
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}
